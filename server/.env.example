# 必填
ANTHROPIC_API_KEY=sk-ant-xxx
# 公司自建 Claude 网关；走官方 API 时留空
ANTHROPIC_BASE_URL=https://awsclaude.tevaupay.com
DB_URL=sqlite+aiosqlite:///./ai_engine.db

# Sourcegraph 代码索引（MVP-1 自部署，见 docker-compose）
SOURCEGRAPH_URL=http://localhost:7080
SOURCEGRAPH_TOKEN=

# OpenAPI 文档（从 Apifox 项目导出的 OpenAPI 3.0 JSON）
OPENAPI_DOC_PATH=./repos/api-docs/openapi.json

# 可选
DEFAULT_MODEL=claude-sonnet-4-6
HEAVY_MODEL=claude-opus-4-7
PROMPTS_DIR=./src/ai_engine/prompts
LARK_WEBHOOK_URL=
EVENT_CENTER_URL=http://localhost:8000/_mock/event-center
EVENT_CENTER_SECRET=
# HMAC 双 key 热轮换（spec §7.4）：出口签名用 current，验签 current/previous 任一通过。
# 必填强随机值（不要用旧的 mvp1-shared-secret），否则可被伪造回调篡改工单。
EVENT_CENTER_SECRET_CURRENT=change-me-to-strong-random
EVENT_CENTER_SECRET_PREVIOUS=
# 仅本地 dev 挂 /_mock/event-center；生产连真实事项中心，置 false / 不设
MOCK_EVENT_CENTER=false
# 客服 JWT 签名密钥（HS256）；必填，留空则客服登录/验签一律拒绝（防空密钥伪造 admin）
STAFF_JWT_SECRET=change-me-to-strong-random
# B 端 session cookie 签名密钥（HS256）；必填，留空则 B 端登录不可用
BU_SESSION_SECRET=change-me-to-strong-random
# 仅内网联调置 true：信任客户端 X-BU-ID header 当 B 端身份。生产必须 false，否则可伪造商户身份
DEV_TRUST_BU_HEADER=false
# /metrics Bearer 鉴权令牌（可选）；留空则不鉴权，建议生产配置或用网络层限制
METRICS_AUTH_TOKEN=
# 允许跨域携带 cookie 的前端来源（JSON 数组）；生产改为真实域名
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# 业务只读库（MVP-2；生产用阿里云 RDS 只读账号，见 docs/resources.md）
UNLIMITPAY_DB_URL=mysql://tevau_test_read:<password>@<host>:<port>/unlimitpay_test
NEXUS_DB_URL=mysql://nexus_test_read:<password>@<host>:<port>/nexus_test
# C 端 APP JWT 验签（APP 后端签发，本服务只验签不签发）；公钥由 APP 团队提供
APP_JWT_PUBLIC_KEY=
APP_JWT_ALGORITHM=RS256
MAX_TOOL_DEPTH=12
MAX_TOOL_RESULT_BYTES=262144
# spec §6.4 兜底层：单 subject 每分钟消息上限
CHAT_RATE_LIMIT_PER_MIN=30
# 限流共享存储；配置后多副本全局精确计数，留空则回退进程内（单副本/本地）
REDIS_URL=redis://localhost:6379/0
# spec §6.4 第二层 haiku 前置话题分类（防通用 Claude 滥用）；MVP-2 起按需开启，约 +5% 成本
TOPIC_CLASSIFIER_ENABLED=false
LOG_LEVEL=INFO
