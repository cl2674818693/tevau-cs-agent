{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "AI 引擎 /metrics 抓取的 Prometheus 数据源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Tevau 客服 AI 引擎",
  "uid": "tevau-ai-engine",
  "tags": ["tevau", "ai-engine"],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "实时运营", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat",
      "title": "在线对话数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "ai_engine_active_conversations", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "等待人工的会话数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "ai_engine_human_pending", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "AI 平均工具耗时 (p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_engine_tool_duration_seconds_bucket[5m])) by (le, tool))",
          "refId": "A",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "工具调用错误率",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_tool_calls_total{ok=\"false\"}[5m])) / clamp_min(sum(rate(ai_engine_tool_calls_total[5m])), 1)",
          "refId": "A",
          "legendFormat": "error rate"
        }
      ]
    },
    { "type": "row", "title": "趋势", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 } },
    {
      "type": "timeseries",
      "title": "对话量 (LLM 调用 rate)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_llm_calls_total[5m])) by (model)",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token 消耗 (input/output)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_llm_tokens_total[5m])) by (kind)",
          "refId": "A",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "估算成本 ($/h, sonnet 价)",
      "description": "input $3/M、output $15/M 估算；按实际合同价调整系数。",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_llm_tokens_total{kind=\"input\"}[1h])) * 3600 * 3 / 1e6 + sum(rate(ai_engine_llm_tokens_total{kind=\"output\"}[1h])) * 3600 * 15 / 1e6",
          "refId": "A",
          "legendFormat": "USD/h"
        }
      ]
    },
    { "type": "row", "title": "质量", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 } },
    {
      "type": "timeseries",
      "title": "工单创建 (按 category)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_tickets_total[1h])) by (category)",
          "refId": "A",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "用户\"未解决\"比例",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(ai_engine_user_resolved_total{event=\"user_rejected_resolved\"}) / clamp_min(sum(ai_engine_user_resolved_total), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "客服平均接管时长 (p50/p90)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(ai_engine_staff_takeover_seconds_bucket[1h])) by (le))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(ai_engine_staff_takeover_seconds_bucket[1h])) by (le))",
          "refId": "B",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "工单解决耗时 (p90, 按 category)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum(rate(ai_engine_ticket_resolution_seconds_bucket[6h])) by (le, category))",
          "refId": "A",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "等待人工的会话数",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "targets": [{ "expr": "ai_engine_human_pending", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "客服接管次数 (Top)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "targets": [
        {
          "expr": "topk(10, sum(rate(ai_engine_staff_takeovers_total[1h])) by (staff_id))",
          "refId": "A",
          "legendFormat": "{{staff_id}}"
        }
      ]
    },
    { "type": "row", "title": "留痕 / 可靠性", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 } },
    {
      "type": "timeseries",
      "title": "话题判定分布 (yes/no/uncertain)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 31 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_topic_verdict_total[5m])) by (verdict)",
          "refId": "A",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "消息反馈 👍/👎",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 31 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_message_feedback_total[5m])) by (rating)",
          "refId": "A",
          "legendFormat": "{{rating}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "回合失败兜底 (fail-soft)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 31 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_llm_turn_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "失败/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "僵尸回合清理",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 31 },
      "targets": [
        {
          "expr": "sum(rate(ai_engine_stale_turns_reclaimed_total[5m]))",
          "refId": "A",
          "legendFormat": "清理/s"
        }
      ]
    }
  ]
}
