server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 静态资源直接 serve；SPA fallback 到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反代（与 web/vite.config.ts 的 proxy 前缀对齐）
    location ~ ^/(api|staff/api|admin/api)/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE 长连接所需：关闭缓冲、保持连接、放长超时
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    # 静态资源缓存（hash 文件名可以放心长缓存）
    location ~* \.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
